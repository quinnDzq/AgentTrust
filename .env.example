# Copy this file to .env in the repository root.
# Use the client ID and secret from the same PayPal Sandbox REST app.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Default spending cap in USD and threshold for additional buyer approval.
# AGENTTRUST_DEFAULT_BUDGET=20
# AGENTTRUST_ASK_THRESHOLD_PCT=50

# Identity defaults to local Ed25519. To check an ERC-8004 registration, configure these fields.
# AGENTTRUST_IDENTITY_MODE=local
# AGENTTRUST_ERC8004_NETWORK=base-sepolia
# AGENTTRUST_ERC8004_AGENT_ID=
# AGENTTRUST_ERC8004_OWNER=

# The signer and MCP connector generate their own local tokens by default.
# Set these only to provide your own tokens through the server environment.
# AGENTTRUST_SIGNER_TOKEN=
# AGENTTRUST_MCP_TOKEN=
# AGENTTRUST_REFERENCE_PATH=reference/numeric-294-355.json
# AGENTTRUST_CALIBRATE_AS=

# Browser-accessible app origin for PayPal returns, if different from localhost.
# PUBLIC_BASE_URL=http://localhost:8787
